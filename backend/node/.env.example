# ====================================================================
# SmartPick AI Advisor & Catalog Engine - Environment Configuration
# ====================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (personalized advice generation & query intent extraction).
# AI Studio automatically injects this at runtime from user secrets.
# When omitted, SmartPick runs smoothly using deterministic heuristic rule matching.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Local development and production listening port (defaults to 3000)
PORT="3000"

# NODE_ENV: Application environment ('development' | 'production' | 'test')
NODE_ENV="development"

# JWT_SECRET: Cryptographic secret key used to sign and verify user and admin authentication tokens.
# In production, must be at least 32 characters of high-entropy random characters.
JWT_SECRET="smartpick_super_secure_jwt_secret_key_change_in_production_2025"

# JWT_EXPIRES_IN: Token lifespan (e.g., '7d', '24h', '1h')
JWT_EXPIRES_IN="7d"

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins or '*'
# Example: "http://localhost:3000,https://my-domain.run.app"
CORS_ALLOWED_ORIGINS="*"

# RATE_LIMIT_WINDOW_MS: Window duration in milliseconds for sliding-window rate limiters (default: 900000 = 15m)
RATE_LIMIT_WINDOW_MS="900000"

# RATE_LIMIT_MAX_REQUESTS: Maximum allowed requests per IP within the rate limit window
RATE_LIMIT_MAX_REQUESTS="200"
