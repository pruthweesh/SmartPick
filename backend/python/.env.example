# ====================================================================
# SmartPick FastAPI Backend - Environment Configuration (Render)
# ====================================================================

# Port is automatically assigned by Render at runtime via $PORT
PORT=8000

# Application Environment ('production' | 'development')
ENVIRONMENT=production

# Database Connection URL:
# For SQLite on Render (ephemeral without persistent disk):
DATABASE_URL=sqlite:///./smartpick.db
# For production PostgreSQL (e.g. Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# JWT Secret Key for token signing and validation
# On Render, you can let Render generate this or set a 32+ character random string
JWT_SECRET=generate_a_random_32_character_secret_key_here

# Allowed origins for CORS (comma-separated list of your Vercel domains)
# Example: https://smartpick.vercel.app,https://smartpick-preview.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Google Gemini API Key for AI Advisor reasoning and extraction
GEMINI_API_KEY=your_gemini_api_key_here
